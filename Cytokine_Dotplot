  scale_fill_identity() +
  # 2) Manual gridlines — horizontal + vertical (one per SEX level)
  geom_hline(yintercept = seq_along(cyt_levels),
             color = "white", linewidth = 0.5) +
  geom_vline(xintercept = seq_along(sex_levels),
             color = "white", linewidth = 0.5) +
