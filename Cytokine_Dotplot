# -------------------------------------------------------------------
# Impution of Cytokines with < 30% Zero Values
# -------------------------------------------------------------------

impute_lod_sqrt2 <- function(input_data, cols = NULL, cytokine_llod, zero_cutoff = 0.30) {
  library(dplyr)

  # Convert input to data frame
  imputed_data <- as.data.frame(input_data)

  # Determine which columns to process
  if (is.null(cols)) {
    cols <- intersect(colnames(imputed_data), cytokine_llod$Analyte)
  }

  # Track which cytokines were imputed or valid
  valid_cytokines <- c()
  skipped_list <- list()  # store skipped cytokines info

  # Loop through each cytokine
  for (col_name in cols) {
    if (col_name %in% colnames(imputed_data)) {
      # Get analyte-specific LLOD
      lod <- cytokine_llod %>%
        filter(Analyte == col_name) %>%
        pull(LLOD)

      if (length(lod) != 1) next  # skip if LLOD missing

      # Compute zero proportion per SEX
      zero_props <- imputed_data %>%
        group_by(SEX) %>%
        summarise(zero_prop = mean(get(col_name) == 0, na.rm = TRUE), .groups = "drop")

      # If zeros per sex are under cutoff, consider valid
      if (all(zero_props$zero_prop <= zero_cutoff)) {
        if (any(zero_props$zero_prop > 0)) {
          imputed_data[[col_name]][imputed_data[[col_name]] == 0] <- lod / sqrt(2)
        }
        valid_cytokines <- c(valid_cytokines, col_name)
      } else {
        skipped_list[[col_name]] <- zero_props
      }
    }
  }

  # Combine skipped cytokines into a table
  if (length(skipped_list) > 0) {
    skipped_cytokines <- bind_rows(
      lapply(names(skipped_list), function(x) {
        df <- skipped_list[[x]]
        df$Cytokine <- x
        df
      })
    ) %>%
      select(Cytokine, SEX, zero_prop)
  } else {
    skipped_cytokines <- data.frame(
      Cytokine = character(0),
      SEX = character(0),
      zero_prop = numeric(0)
    )
  }

  list(
    data = imputed_data,
    valid_cytokines = valid_cytokines,
    skipped_cytokines = skipped_cytokines
  )
}


