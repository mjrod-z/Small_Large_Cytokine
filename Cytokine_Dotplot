  geom_point(aes(color = mean_log2FC, size = size_val, shape = sig), alpha = 0.9) +
  shape_scale_sex +
  facet_grid(rows = vars(CELLTYPE), cols = vars(HORMONE), drop = FALSE) +
  scale_x_discrete(expand = expansion(mult = c(0.4, 0.4)), drop = TRUE) +
  scale_y_discrete(drop = FALSE) +
  color_scale + size_scale +
  ref_theme() +
  theme(
