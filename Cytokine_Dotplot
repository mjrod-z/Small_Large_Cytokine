# -------------------------------------------------------------------
# Outlier detection (Grubbs)
# -------------------------------------------------------------------

outlier_test_grubbs <- function(input_data, alpha = 0.9) {
  result_list <- list()
  pbs_columns <- grep("_PBS$", names(input_data), value = TRUE)

  for (column_name in pbs_columns) {
    if (any(is.na(input_data[[column_name]]))) {
      cat("Column", column_name, "contains missing values. Grubbs' test not performed.\n")
    } else {
      grubbs_test_result <- grubbs.test(input_data[[column_name]], two.sided = TRUE)
      if (!is.null(grubbs_test_result)) {
        num_outliers <- length(grubbs_test_result$alternative)
        cat("Column", column_name, "Number of outliers detected:", num_outliers, "\n")
        result_list[[column_name]] <- num_outliers
      } else {
        cat("Column", column_name, "No outliers detected.\n")
        result_list[[column_name]] <- 0
      }
    }
  }

  return(result_list)
}

