  left_join(
    sig_All %>% filter(CYTOKINE %in% keep_cytokines) %>%
      select(CELLTYPE, HORMONE, CYTOKINE, sig_pooled = sig),
    by = c("CELLTYPE", "HORMONE", "CYTOKINE")
  ) %>%
  mutate(
    sig_pooled = ifelse(is.na(sig_pooled), FALSE, sig_pooled),
    All        = factor("All", levels = "All"),
    # Panel fill determined by HORMONE
   panel_fill = ifelse(as.character(HORMONE) == "E2",
                    estradiol_fill, panel_fill_none)
