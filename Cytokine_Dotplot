add_rescaled_size <- function(df, value_col,
                              clamp_quantile = 0.95,
                              transform = c("sqrt", "log1p", "none"),
                              out_col = "size_val") {
  transform <- match.arg(transform)
  mag  <- abs(df[[value_col]])
  cap  <- stats::quantile(mag, probs = clamp_quantile, na.rm = TRUE, names = FALSE)
  if (!is.finite(cap) || cap <= 0) cap <- max(mag, na.rm = TRUE)
  mag2 <- pmin(mag, cap)
  df[[out_col]] <- switch(transform, sqrt = sqrt(mag2), log1p = log1p(mag2), none = mag2)
  df
}

make_log2fc_long <- function(df, cytokine_cols, pbs_level,
                             exclude_exposures = character(0), pseudocount = 1e-6) {
  d <- df %>%
    filter(!EXPOSURE %in% exclude_exposures) %>%
    mutate(
      SEX         = as.character(SEX),
      CELLTYPE    = factor(CELLTYPE),
      HORMONE     = factor(HORMONE),
      EXPOSURE    = factor(EXPOSURE),
      PLATE       = factor(PLATE),
      PATIENTCODE = factor(PATIENTCODE)
    )
  long <- d %>%
    pivot_longer(cols = all_of(cytokine_cols), names_to = "CYTOKINE", values_to = "VALUE") %>%
    filter(!is.na(VALUE)) %>%
    mutate(log2_val = log2(as.numeric(VALUE) + pseudocount))
  pbs <- long %>%
    filter(EXPOSURE == pbs_level) %>%
    select(PATIENTCODE, PLATE, CELLTYPE, HORMONE, CYTOKINE, log2_pbs = log2_val)
  long %>%
    filter(EXPOSURE != pbs_level) %>%
    left_join(pbs, by = c("PATIENTCODE", "PLATE", "CELLTYPE", "HORMONE", "CYTOKINE")) %>%
    mutate(log2FC = log2_val - log2_pbs)
}

screen_one_exposure_lmer_log2 <- function(df, cytokine_cols, target_exposure,
                                          ctrl_level = "PBS Control",
                                          exclude_exposures = character(0),
                                          pseudocount = 1e-6,
                                          group = c("All", "F", "M"),
                                          alpha = 0.1,
                                          emmeans_weights = c("equal", "proportional")) {
  group           <- match.arg(group)
  emmeans_weights <- match.arg(emmeans_weights)
  d0 <- df %>%
    filter(!EXPOSURE %in% exclude_exposures,
           EXPOSURE %in% c(ctrl_level, target_exposure))
  if (group %in% c("F", "M")) d0 <- d0 %>% filter(as.character(SEX) == group)
  d0 <- d0 %>%
    mutate(EXPOSURE = factor(EXPOSURE), PLATE = factor(PLATE),
           PATIENTCODE = factor(PATIENTCODE), CELLTYPE = factor(CELLTYPE),
           HORMONE = factor(HORMONE))
  if (ctrl_level %in% levels(d0$EXPOSURE))
    d0$EXPOSURE <- relevel(d0$EXPOSURE, ref = ctrl_level)
  has_empty <- function(dat) any(xtabs(~ PLATE + EXPOSURE, data = dat) == 0)
  get_contrast <- function(fit) {
    emm  <- emmeans(fit, ~ EXPOSURE, weights = emmeans_weights)
    levs <- levels(emm@grid$EXPOSURE)
    v    <- if (identical(levs, c(ctrl_level, target_exposure))) c(-1, 1) else c(1, -1)
    contrast(emm, method = list(v), adjust = "none")
  }
  combos        <- d0 %>% distinct(CELLTYPE, HORMONE)
  cytokine_cols <- intersect(cytokine_cols, names(d0))
  out           <- list()
  for (i in seq_len(nrow(combos))) {
    ct   <- combos$CELLTYPE[i]
    ho   <- combos$HORMONE[i]
    dsub <- d0 %>% filter(CELLTYPE == ct, HORMONE == ho)
    if (!all(c(ctrl_level, target_exposure) %in% unique(dsub$EXPOSURE))) next
    for (cyt in cytokine_cols) {
      dat <- dsub %>% filter(!is.na(.data[[cyt]]))
      if (nrow(dat) < 3) next
      if (!all(c(ctrl_level, target_exposure) %in% unique(dat$EXPOSURE))) next
      dat  <- dat %>% mutate(resp = log2(.data[[cyt]] + pseudocount))
      form <- if (!has_empty(dat)) resp ~ PLATE * EXPOSURE + (1 | PATIENTCODE) else
                                   resp ~ EXPOSURE + PLATE + (1 | PATIENTCODE)
      fit <- try(suppressWarnings(lmer(form, data = dat)), silent = TRUE)
      if (inherits(fit, "try-error"))
        fit <- try(suppressWarnings(
          lmer(resp ~ EXPOSURE + PLATE + (1 | PATIENTCODE), data = dat)), silent = TRUE)
      if (inherits(fit, "try-error")) next
      con <- try(get_contrast(fit), silent = TRUE)
      if (inherits(con, "try-error")) {
        fit2 <- try(suppressWarnings(
          lmer(resp ~ EXPOSURE + PLATE + (1 | PATIENTCODE), data = dat)), silent = TRUE)
        if (!inherits(fit2, "try-error")) con <- try(get_contrast(fit2), silent = TRUE)
      }
      if (inherits(con, "try-error")) next
      s <- as.data.frame(summary(con))
      out[[paste(group, ct, ho, cyt, sep = "|")]] <- tibble(
        SEX      = ifelse(group == "All", "All", group),
        CELLTYPE = as.character(ct), HORMONE = as.character(ho),
        EXPOSURE = target_exposure, CYTOKINE = cyt,
        estimate = s$estimate[1], SE = s$SE[1], p.value = s$p.value[1]
      )
    }
  }
  bind_rows(out) %>%
    group_by(SEX, CELLTYPE, HORMONE, EXPOSURE) %>%
    mutate(q = p.adjust(p.value, method = "fdr"), sig = q < alpha) %>%
    ungroup()
}

run_group_lmer_screen <- function(df, cytokine_cols, target_exposure,
                                  ctrl_level = "PBS Control",
                                  exclude_exposures = character(0),
                                  sex_group = "All") {
  d0 <- df %>%
    filter(!EXPOSURE %in% exclude_exposures,
           EXPOSURE %in% c(ctrl_level, target_exposure))
  if (sex_group %in% SEX_LEVELS) {
    d0 <- d0 %>% filter(as.character(SEX) == sex_group)
  } else {
    d0 <- d0 %>% filter(as.character(SEX) %in% SEX_LEVELS)
  }
  d0 <- d0 %>%
    mutate(
      EXPOSURE    = factor(EXPOSURE),
      PATIENTCODE = factor(PATIENTCODE),
      PLATE       = factor(PLATE),
      CELLTYPE    = factor(CELLTYPE),
      HORMONE     = factor(HORMONE)
    )
  strata <- d0 %>% distinct(CELLTYPE, HORMONE)
  out <- vector("list", nrow(strata))
  for (i in seq_len(nrow(strata))) {
    ct <- strata$CELLTYPE[i]
    ho <- strata$HORMONE[i]
    dsub <- d0 %>% filter(CELLTYPE == ct, HORMONE == ho)
    if (!all(c(ctrl_level, target_exposure) %in% unique(as.character(dsub$EXPOSURE)))) next
    lmer_res <- try(
      exposure_lmer_pairwise(
        dsub,
        group = "All",
        adjust_method = "fdr",
        response_columns = intersect(cytokine_cols, names(dsub)),
        ctrl_level = ctrl_level
      ),
      silent = TRUE
    )
    if (inherits(lmer_res, "try-error") || nrow(lmer_res) == 0) next
    out[[i]] <- lmer_res %>%
      transmute(
        SEX      = sex_group,
        CELLTYPE = as.character(ct),
        HORMONE  = as.character(ho),
        EXPOSURE = target_exposure,
        CYTOKINE = response,
        estimate = estimate,
        SE       = SE,
        p.value  = p.value
      )
  }
  bind_rows(out) %>%
    group_by(SEX, CELLTYPE, HORMONE, EXPOSURE) %>%
    mutate(
      q   = p.adjust(p.value, method = "fdr"),
      sig = q < ALPHA_Q
    ) %>%
    ungroup()
}

