summarize_to_wide <- function(df, measure_vars) {
  
  # --- Allow numeric column positions (e.g., 2:30) ---
  if (is.numeric(measure_vars)) {
    measure_vars <- names(df)[measure_vars]
  }
  
  # --- Mean and SD by EXPOSURE × SEX ---
  summary_sex <- df %>%
    group_by(EXPOSURE, SEX) %>%
    summarise(
      across(all_of(measure_vars),
             list(mean = ~mean(.x, na.rm = TRUE),
                  sd   = ~sd(.x, na.rm = TRUE))),
      .groups = "drop"
    )
  
  # --- Mean and SD for pooled SEX ("All") ---
  summary_all <- df %>%
    group_by(EXPOSURE) %>%
    summarise(
      across(all_of(measure_vars),
             list(mean = ~mean(.x, na.rm = TRUE),
                  sd   = ~sd(.x, na.rm = TRUE))),
      .groups = "drop"
    ) %>%
    mutate(SEX = "All")
  
  # --- Combine ---
  summary_combined <- bind_rows(summary_sex, summary_all)
  
  # --- Long format and combine mean ± sd ---
  summary_long <- summary_combined %>%
    pivot_longer(
      cols = -c(EXPOSURE, SEX),
      names_to = c("Measurement", "Stat"),
      names_sep = "_"
    ) %>%
    pivot_wider(
      names_from = Stat,
      values_from = value
    ) %>%
    mutate(
      Value = sprintf("%.1f ± %.1f", mean, sd),
      Measurement = paste0(Measurement, "_", SEX)
    ) %>%
    select(EXPOSURE, Measurement, Value)
  
  # --- Return wide table ---
  summary_wide <- summary_long %>%
    pivot_wider(names_from = EXPOSURE, values_from = Value)
  
  return(summary_wide)
}
