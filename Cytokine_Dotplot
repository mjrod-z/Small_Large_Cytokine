# ----------------------------
# 7) Build plots
# Key trick for per-facet background color:
# Add geom_tile as the FIRST layer covering the whole panel,
# filled by panel_fill (which is set per row based on HORMONE).
# Then plot dots on top. The tile covers x+y discrete space.
# ----------------------------
# Helper: get y positions for manual gridlines (one per cytokine level)
cyt_levels <- levels(factor(plot_df_pooled$CYTOKINE, levels = cyt_order))
sex_levels <- c("M", "F")

# LEFT: pooled
p_pooled <- ggplot(plot_df_pooled, aes(x = All, y = CYTOKINE)) +
  # 1) Background tile (per-facet color)
  geom_tile(aes(fill = panel_fill), width = Inf, height = 1,
            alpha = 1, show.legend = FALSE) +
  scale_fill_identity() +
  # 2) Manual gridlines — horizontal only (only 1 x position so no vertical needed)
  geom_hline(yintercept = seq_along(cyt_levels),
             color = "white", linewidth = 0.5) +
  geom_vline(xintercept = seq_along("All"),
             color = "white", linewidth = 0.5) +
  # 3) Dots
  geom_point(aes(color = mean_log2FC, size = size_val, shape = sig_pooled), alpha = 0.9) +
  shape_scale_pooled +
  facet_grid(rows = vars(CELLTYPE), cols = vars(HORMONE), drop = FALSE) +
  scale_x_discrete(expand = expansion(mult = c(0.8, 0.8)), drop = TRUE) +
  scale_y_discrete(drop = FALSE) +
  color_scale + size_scale +
  ref_theme() +
  labs(title = paste0(target_exposure, " \u00b1 17β-Estradiol"), y = "Cytokine")

