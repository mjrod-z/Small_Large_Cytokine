recode_hormone <- function(df) {
  df %>% mutate(
    HORMONE = dplyr::recode(as.character(HORMONE),
                            "NONE"      = "Control",
                            "Estradiol" = "E2"),
    HORMONE = factor(HORMONE, levels = c("Control", "E2"))
  )
}

sig_F   <- recode_hormone(sig_F)
sig_M   <- recode_hormone(sig_M)
sig_All <- recode_hormone(sig_All)

keep_cytokines <- bind_rows(sig_F, sig_M, sig_All) %>%
