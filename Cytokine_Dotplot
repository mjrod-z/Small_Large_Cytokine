    ) +
    geom_histogram(position = "identity", alpha = 0.65, bins = 20, color = "grey40") +
    facet_grid(rows = vars(CELLTYPE), cols = vars(HORMONE)) +
    theme_minimal(base_size = 12) +
    scale_fill_manual(values = c("M" = "lemonchiffon", "F" = "white"), name = "Sex") +
    labs(
      title = paste("Raw Value Histogram for", cyt, "\n", target_exposure),
      x     = paste(cyt, "(pg/mL)"),
      y     = "Count"
    )

      # 8. BARPLOT
  y_max     <- max(summary_raw$mu + summary_raw$sd, na.rm = TRUE)
  y_bracket <- y_max * 1.10   # <<< bracket height — closer to bars

  # Background dataset
  bg_df <- summary_raw %>%
    distinct(CELLTYPE, HORMONE, panel_fill)

  # Lighter male point color
  male_point_fill <- colorspace::lighten(border_color, amount = 0.4)

  d_raw <- d_raw %>%
    mutate(
      point_fill = case_when(
        SEX == "M" & EXPOSURE == pbs_level       ~ "grey80",
        SEX == "M" & EXPOSURE == target_exposure ~ male_point_fill,
        TRUE                                     ~ "white"
      ),
      point_color = case_when(
        EXPOSURE == pbs_level       ~ "grey40",
        EXPOSURE == target_exposure ~ border_color,
        TRUE                        ~ "grey40"
      )
    )

  # Bracket data
  bracket_df <- summary_raw %>%
    filter(EXPOSURE == target_exposure, sig_label != "") %>%
    mutate(
      x_left   = as.numeric(x_label) - 1,   # Control bar position
      x_right  = as.numeric(x_label),        # Exposure bar position
      x_center = as.numeric(x_label) - 0.5, # <<< midpoint between the two bars
      y_top    = y_bracket
    )

  p_bar_raw <- ggplot(summary_raw, aes(x = x_label, y = mu)) +

    # (A) ONE background tile per facet panel
    geom_rect(
      data        = bg_df,
      aes(fill    = panel_fill),
      xmin        = -Inf, xmax = Inf,
      ymin        = -Inf, ymax = Inf,
      inherit.aes = FALSE,
      show.legend = FALSE
    ) +
    scale_fill_identity() +

    # (B) White gridlines
    geom_hline(
      yintercept = pretty(c(0, y_max)),
      color      = "white",
      linewidth  = 0.5
    ) +
    new_scale_fill() +

    # (C) Male bars — fully filled
    geom_col_pattern(
      data = summary_raw %>% filter(SEX == "M"),
      aes(x = x_label, fill = bar_fill, color = bar_color, pattern = pattern),
      pattern_fill    = "grey30",
      pattern_angle   = 45,
      pattern_density = 0.1,
      pattern_spacing = 0.05,
      pattern_size    = 0.3,
      width           = 0.9,
      linewidth       = 0.7,
      alpha           = 1
    ) +

    # (D) Female bars — transparent
    geom_col_pattern(
      data = summary_raw %>% filter(SEX == "F"),
      aes(x = x_label, fill = bar_fill, color = bar_color, pattern = pattern),
      pattern_fill    = "grey30",
      pattern_angle   = 45,
      pattern_density = 0.1,
      pattern_spacing = 0.05,
      pattern_size    = 0.3,
      width           = 0.9,
      linewidth       = 0.7,
      alpha           = 0
    ) +

    scale_fill_identity(guide  = "none") +
    scale_color_identity(guide = "none") +
    scale_pattern_manual(
      name   = "Exposure",
      values = c("stripe" = "stripe", "none" = "none"),
      labels = c("stripe" = "Control", "none" = exp_short)
    ) +

    # (E) Error bars
    geom_errorbar(
      aes(x = x_label, ymin = mu - sd, ymax = mu + sd),
      width     = 0.2,
      linewidth = 0.6,
      color     = "grey20"
    ) +

    # (F) Bracket horizontal bar
    geom_segment(
      data = bracket_df,
      aes(x = x_left, xend = x_right,
          y = y_top,  yend = y_top,
          color = sig_color),
      linewidth   = 0.7,
      inherit.aes = FALSE,
      show.legend = FALSE
    ) +
    # Left tick
    geom_segment(
      data = bracket_df,
      aes(x = x_left, xend = x_left,
          y = y_top,  yend = y_top - (y_max * 0.04),
          color = sig_color),
      linewidth   = 0.7,
      inherit.aes = FALSE,
      show.legend = FALSE
    ) +
    # Right tick
    geom_segment(
      data = bracket_df,
      aes(x = x_right, xend = x_right,
          y = y_top,   yend = y_top - (y_max * 0.04),
          color = sig_color),
      linewidth   = 0.7,
      inherit.aes = FALSE,
      show.legend = FALSE
    ) +

    # (G1) Asterisks — centered between the two bars, just above bracket
    geom_text(
      data = bracket_df %>% filter(sig_label %in% c("*", "**", "***")),
      aes(
        x     = x_center,                        # <<< centered between bars
        y     = y_top + (y_max * 0.03),           # <<< just above bracket line
        label = sig_label,
        color = sig_color
      ),
      size        = 8,
      fontface    = "bold",
      hjust       = 0.5,                          # <<< force center alignment
      vjust       = 0,
      inherit.aes = FALSE,
      show.legend = FALSE
    ) +

    # (G2) Hash — centered between the two bars, just above bracket
    geom_text(
      data = bracket_df %>% filter(sig_label == "#"),
      aes(
        x     = x_center,                        # <<< centered between bars
        y     = y_top + (y_max * 0.03),           # <<< just above bracket line
        label = sig_label,
        color = sig_color
      ),
      size        = 5,
      fontface    = "bold",
      hjust       = 0.5,                          # <<< force center alignment
      vjust       = 0,
      inherit.aes = FALSE,
      show.legend = FALSE
    ) +

    # (H) Jittered points
    geom_jitter(
      data = d_raw,
      aes(x = x_label, y = VALUE, fill = point_fill, color = point_color),
      shape       = 21,
      width       = 0.12,
      size        = 2.5,
      stroke      = 1.0,
      alpha       = 0.95,
      inherit.aes = FALSE
    ) +
    scale_fill_identity(guide  = "none") +
    scale_color_identity(guide = "none") +

    scale_x_discrete(expand = expansion(add = 0.6)) +

    # <<< tighter y expansion — just enough for bracket + label
    scale_y_continuous(expand = expansion(mult = c(0.02, 0.18))) +

    facet_grid(rows = vars(CELLTYPE), cols = vars(HORMONE)) +
    barplot_theme() +
    labs(
      title = paste0("Raw values for ", cyt, "\n",
                     exp_short, " vs Control (hatched) | M = filled, F = transparent"),
      x     = NULL,
      y     = paste0(cyt, " (pg/mL)")
    ) +
    theme(axis.text.x = element_text(angle = 30, hjust = 1, size = 9))

  # 9. Save
  ggsave(
    file.path(cytokine_out_dir,
              paste0("raw_histogram_", gsub("[^A-Za-z0-9]+", "_", cyt), ".png")),
    p_hist_raw, width = 8, height = 5, units = "in", dpi = 150, bg = "white"
  )
  ggsave(
    file.path(cytokine_out_dir,
              paste0("raw_barplot_", gsub("[^A-Za-z0-9]+", "_", cyt), ".png")),
    p_bar_raw, width = 8, height = 6, units = "in", dpi = 150, bg = "white"
  )
}

