# -------------------------------------------------------------------
# Normality testing and transformations
# -------------------------------------------------------------------

classify_normality <- function(input_data,
                               response_columns = NULL,
                               ctrl_group = "Control") {

  df <- as.data.frame(input_data)

  # ---- Columns to test ----
  cols <- if (is.null(response_columns)) {
    grep("_PBS$", names(df), value = TRUE)
  } else {
    names(df)[response_columns]
  }

  # ---- Helper: run Shapiro on non-control ----
  shapiro_col <- function(x) {
    vals <- df[df$GROUP != ctrl_group | is.na(df$GROUP), x, drop = TRUE]
    shapiro.test(vals)$p.value
  }

  # ---- INITIAL TEST ----
  p_initial <- sapply(cols, shapiro_col)
  normal_initial <- names(p_initial[p_initial >= 0.05])
  non_normal_initial <- names(p_initial[p_initial < 0.05])

  # ---- LOG10 TEST (temporary only) ----
  test_log <- function(col) {
    vals <- df[df$GROUP != ctrl_group | is.na(df$GROUP), col, drop = TRUE]
    min_val <- min(vals, na.rm = TRUE)
    shift <- ifelse(min_val <= 0, abs(min_val) + 1, 0)
    transformed <- log10(vals + shift)
    shapiro.test(transformed)$p.value
  }

  p_log <- if (length(non_normal_initial) > 0) {
    sapply(non_normal_initial, test_log)
  } else numeric(0)

  normal_after_log <- names(p_log[p_log >= 0.05])
  still_non_normal <- names(p_log[p_log < 0.05])

  # ---- SQRT TEST (temporary only) ----
  test_sqrt <- function(col) {
    vals <- df[df$GROUP != ctrl_group | is.na(df$GROUP), col, drop = TRUE]
    transformed <- sqrt(vals + 1)
    shapiro.test(transformed)$p.value
  }

  p_sqrt <- if (length(still_non_normal) > 0) {
    sapply(still_non_normal, test_sqrt)
  } else numeric(0)

  normal_after_sqrt <- names(p_sqrt[p_sqrt >= 0.05])
  final_non_normal <- names(p_sqrt[p_sqrt < 0.05])

  # ---- RETURN ----
  list(
    initially_normal = normal_initial,
    became_normal_after_log10 = normal_after_log,
    became_normal_after_sqrt = normal_after_sqrt,
    still_non_normal = final_non_normal
  )
}


# -------------------------------------------------------------------
# Average Nonzeroes by Sample
# -------------------------------------------------------------------

average_nonzero_by_sample <- function(data, id_col = "SAMPLEID") {
  data %>%
    group_by(.data[[id_col]]) %>%
    summarise(
      across(where(is.numeric), ~ {
        nonzero_vals <- .x[.x != 0]
        if (length(nonzero_vals) > 0) {
          mean(nonzero_vals, na.rm = TRUE)
        } else {
          0  # keep zero if all are zero
        }
      }),
      .groups = "drop"
    ) %>%
    left_join(
      data %>% select(-where(is.numeric)) %>% distinct(),
      by = id_col
    ) %>%
    relocate(names(data))  # restore original column order
}

# -------------------------------------------------------------------
# Aligned Rank Transform ANOVA
# -------------------------------------------------------------------
exposure_art_pairwise <- function(data, group = "All", adjust_method = "fdr",
                                  response_columns = NULL, ctrl_level = "PBS Control") {
  
  # Filter data by group
  filtered_data <- switch(group,
    "M" = data %>% filter(EXPOSURE != "Untreated Control", SEX == "M"),
    "F" = data %>% filter(EXPOSURE != "Untreated Control", SEX == "F"),
    "All" = data %>% filter(EXPOSURE != "Untreated Control"),
    stop("Invalid group. Choose 'All', 'M', or 'F'.")
  )
  
  # Ensure factors
  filtered_data <- filtered_data %>%
    mutate(
      SEX = factor(SEX),
      EXPOSURE = factor(EXPOSURE),
      PATIENTCODE = factor(PATIENTCODE),
      PLATE = factor(PLATE)
    )
  
  # Determine response columns
  if (is.null(response_columns)) {
    # Check if valid_cytokines exists in parent environment
    if (exists("valid_cytokines", envir = parent.frame())) {
      valid_cytokines <- get("valid_cytokines", envir = parent.frame())
      response_columns <- intersect(names(filtered_data), valid_cytokines)
    } else {
      # Auto-detect numeric columns
      response_columns <- names(filtered_data)[sapply(filtered_data, is.numeric)]
    }
  }
  
  results_list <- list()
  
  # Loop over responses
  for (response in response_columns) {
    
    if (!response %in% names(filtered_data)) {
      warning(paste("Column", response, "not found in data"))
      next
    }
    
    # Build formula with random effects
    # ART uses (1|PATIENTCODE) syntax, not Error()
    formula <- if (group == "All") {
      as.formula(paste(response, "~ EXPOSURE * SEX + PLATE + (1|PATIENTCODE)"))
    } else {
      as.formula(paste(response, "~ EXPOSURE + PLATE + (1|PATIENTCODE)"))
    }
    
    # Fit ART model
    m.art <- try(art(formula, data = filtered_data), silent = TRUE)
    
    if (inherits(m.art, "try-error")) {
      warning(paste("ART model failed for", response))
      next
    }
    
    # ANOVA for main and interaction effects
    anova_results <- anova(m.art)
    
    # Extract p-values
    exposure_row <- anova_results[grepl("^EXPOSURE$", anova_results[[1]], ignore.case = TRUE), ]
    exposure_p <- if (nrow(exposure_row) > 0) exposure_row[["Pr(>F)"]][1] else NA
    
    interaction_p <- if (group == "All") {
      inter_row <- anova_results[grepl("EXPOSURE:SEX", anova_results[[1]], ignore.case = TRUE), ]
      if (nrow(inter_row) > 0) inter_row[["Pr(>F)"]][1] else NA
    } else NA
    
    # ART contrasts
    m.art.con <- artlm.con(m.art, "EXPOSURE")
    emm <- emmeans(m.art.con, ~ EXPOSURE)
    
    pairwise <- contrast(
      emm, 
      method = "trt.vs.ctrl", 
      ref = ctrl_level, 
      adjust = adjust_method
    )
    
    # Store results
    results <- as.data.frame(pairwise)
    results$response <- response
    results$exposure_p <- exposure_p
    results$interaction_p <- interaction_p
    
    results_list[[response]] <- results
  }
  
  # Combine all results
  bind_rows(results_list)
}

# -------------------------------------------------------------------
# Linear Mixed-Effects Models
# -------------------------------------------------------------------
exposure_lmer_pairwise <- function(data, group = "All", adjust_method = "fdr",
                                   response_columns = NULL, ctrl_level = "PBS Control") {
  
  # Filter by group
  if (group != "All" && "SEX" %in% names(data)) {
    data <- data %>% filter(SEX == group)
  }
  
  # Check required columns
  stopifnot("EXPOSURE" %in% names(data), "PATIENTCODE" %in% names(data))
  
  # Convert to factors
  data <- data %>%
    mutate(
      EXPOSURE = factor(EXPOSURE),
      PATIENTCODE = factor(PATIENTCODE),
      PLATE = if("PLATE" %in% names(data)) factor(PLATE) else NULL
    )
  
  # Set reference level
  if (ctrl_level %in% levels(data$EXPOSURE)) {
    data$EXPOSURE <- relevel(data$EXPOSURE, ref = ctrl_level)
  }
  
  # Determine response columns
  if (is.null(response_columns)) {
    if (exists("valid_cytokines", envir = parent.frame())) {
      valid_cytokines <- get("valid_cytokines", envir = parent.frame())
      response_columns <- intersect(names(data), valid_cytokines)
    } else {
      response_columns <- names(data)[sapply(data, is.numeric)]
    }
  }
  
  results_list <- list()
  
  for (resp in response_columns) {
    if (!resp %in% names(data)) next
    
    df <- data %>% filter(!is.na(.data[[resp]]))
    if (length(unique(df$EXPOSURE)) < 2) next
    
    # Build model formula with proper random effects
    # Use (1|PATIENTCODE) + (1|PLATE) instead of (1|PATIENTCODE + PLATE)
    model_formula <- if ("PLATE" %in% names(df) && length(unique(stats::na.omit(df$PLATE))) > 1) {
      as.formula(paste(resp, "~ EXPOSURE + PLATE + (1|PATIENTCODE)"))
    } else {
      as.formula(paste(resp, "~ EXPOSURE + (1|PATIENTCODE)"))
    }
    
    model <- try(lmer(model_formula, data = df), silent = TRUE)
    
    if (inherits(model, "try-error")) {
      warning(paste("Model failed for", resp))
      next
    }
    
    emm <- emmeans(model, ~ EXPOSURE)
    pairwise <- contrast(emm, method = "trt.vs.ctrl", ref = ctrl_level, adjust = adjust_method)
    
    pairwise_df <- as.data.frame(summary(pairwise))
    pairwise_df$response <- resp
    
    results_list[[resp]] <- pairwise_df
  }
  
  bind_rows(results_list)
}

interaction_lmer_pairwise <- function(data, group = "All", adjust_method = "fdr",
                                      response_columns = NULL, ctrl_level = "PBS Control") {
  
  # Filter by group (but for interaction analysis, typically keep All)
  if (group != "All" && "SEX" %in% names(data)) {
    data <- data %>% filter(SEX == group)
  }
  
  # Check required columns
  stopifnot("EXPOSURE" %in% names(data), "PATIENTCODE" %in% names(data), "SEX" %in% names(data))
  
  # Convert to factors
  data <- data %>%
    mutate(
      EXPOSURE = factor(EXPOSURE),
      PATIENTCODE = factor(PATIENTCODE),
      SEX = factor(SEX),
      PLATE = if("PLATE" %in% names(data)) factor(PLATE) else NULL
    )
  
  # Set reference level
  if (ctrl_level %in% levels(data$EXPOSURE)) {
    data$EXPOSURE <- relevel(data$EXPOSURE, ref = ctrl_level)
  }
  
  # Determine response columns
  if (is.null(response_columns)) {
    if (exists("valid_cytokines", envir = parent.frame())) {
      valid_cytokines <- get("valid_cytokines", envir = parent.frame())
      response_columns <- intersect(names(data), valid_cytokines)
    } else {
      response_columns <- names(data)[sapply(data, is.numeric)]
    }
  }
  
  results_list <- list()
  
  for (resp in response_columns) {
    if (!resp %in% names(data)) next
    
    df <- data %>% filter(!is.na(.data[[resp]]))
    if (length(unique(df$EXPOSURE)) < 2 || length(unique(df$SEX)) < 2) next
    
    # Build model formula with proper random effects
    model_formula <- if ("PLATE" %in% names(df) && length(unique(df$PLATE)) > 1) {
      as.formula(paste(resp, "~ EXPOSURE * SEX + PLATE + (1|PATIENTCODE)"))
    } else {
      as.formula(paste(resp, "~ EXPOSURE * SEX + PLATE + (1|PATIENTCODE)"))
    }
    
    model <- try(lmer(model_formula, data = df), silent = TRUE)
    
    if (inherits(model, "try-error")) {
      warning(paste("Model failed for", resp))
      next
    }
    
    # Main exposure effects (vs control)
    emm_exposure <- emmeans(model, ~ EXPOSURE)
    pairwise_exposure <- contrast(emm_exposure, method = "trt.vs.ctrl", ref = ctrl_level, adjust = adjust_method)
    exposure_df <- as.data.frame(summary(pairwise_exposure))
    exposure_df$type <- "Exposure_vs_Control"
    exposure_df$response <- resp
    
    # Sex differences within each exposure
    emm_interaction <- emmeans(model, ~ SEX | EXPOSURE)
    interaction_contrast <- contrast(emm_interaction, "pairwise", simple = "SEX", combine = TRUE)
    interaction_df <- as.data.frame(summary(interaction_contrast))
    interaction_df$type <- "Sex_within_Exposure"
    interaction_df$response <- resp
    
    results_list[[resp]] <- bind_rows(exposure_df, interaction_df)
  }
  
  bind_rows(results_list)
}

